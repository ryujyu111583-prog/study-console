# /api/send-reminders を外部から保護するための合言葉（自分で決めた文字列でよい）
CRON_SECRET=

# Firebase Admin SDK用サービスアカウント（JSON全体を1行にして貼る）
FIREBASE_SERVICE_ACCOUNT_KEY=
